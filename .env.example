# Royal Reels Casino - Environment Variables
# Copy this file to .env and fill in your values

# Database Configuration
DB_USER=reels_user
DB_PASSWORD=your_secure_password_here
DB_NAME=royal_reels
DB_HOST=postgres
DB_PORT=5432

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# Node.js Backend
NODE_ENV=development
API_PORT=3001
LOG_LEVEL=info

# Auth
# Generate with: openssl rand -hex 32
# The API refuses to start in production while this is the template default.
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_SECONDS=2592000
BCRYPT_ROUNDS=10

# Admin seed account (npm run seed:admin)
# Leave ADMIN_PASSWORD unset to have one generated and printed once.
ADMIN_EMAIL=admin@royalreels.local
ADMIN_NAME=Floor Manager
# ADMIN_PASSWORD=

# Wallet
# Simulated deposits exist so the dev stack has a balance to play with.
# Must be false anywhere real money is involved; production start-up enforces that.
ALLOW_SIMULATED_DEPOSITS=true
MAX_DEPOSIT_CENTS=500000
MIN_WITHDRAWAL_CENTS=1000
# Starting balance handed to empty wallets by npm run seed:wallets
SEED_BALANCE_CENTS=100000

# Frontend
REACT_APP_API_URL=http://localhost:3001
REACT_APP_WS_URL=ws://localhost:3001

# Payment Gateway (Stripe) - not yet wired up; see LAUNCH_GUIDE.md
STRIPE_PUBLIC_KEY=pk_test_your_key_here
STRIPE_SECRET_KEY=sk_test_your_key_here

# KYC/AML Service - not yet wired up; submissions store a provider reference only
KYC_API_KEY=your_kyc_service_api_key
KYC_API_URL=https://api.kyc-service.com

# Email Service
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password

# Security
CORS_ORIGIN=http://localhost:3000
